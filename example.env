# HK Property Radar — environment variables TEMPLATE.
#
# LOCAL USE:  copy this file to ".env"  (cp example.env .env)  and fill in your key(s).
#             ".env" is gitignored, so it NEVER gets uploaded to GitHub. Safe.
# PRODUCTION: do NOT put keys here. Add them as GitHub repository Secrets instead
#             (Settings -> Secrets and variables -> Actions). The workflow reads them.
#
# Never commit a real key. This template stays empty.

# Powers the AI news summaries + "Top 3 moves" brief. Get one at platform.deepseek.com
DEEPSEEK_API_KEY=

# --- Optional: email brief (only if you set up the Cloudflare Worker) ---
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=          # a Gmail *App Password*, not your normal password
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_KV_NAMESPACE_ID=
# DASHBOARD_URL=              # your github.io link, used in the email footer
